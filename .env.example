# Copy this file to .env.local and fill in your own project's values.
# .env.local is already git-ignored (see .gitignore: "*.local").
#
# Both values below are PUBLIC by design — they are bundled into the
# browser build. The publishable key is the low-privilege "anon" key
# (sb_publishable_...), never the secret/service-role key. Never put a
# secret key or database password in any VITE_-prefixed variable: anything
# with that prefix is shipped to every visitor's browser.

# Project Settings → Data API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings → API Keys → Publishable key (starts with sb_publishable_)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
